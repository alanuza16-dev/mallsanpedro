# Copia este archivo como .env.local para desarrollo. En Vercel, crea estas variables en
# Project Settings > Environment Variables.

# Obligatorias ------------------------------------------------------------
# Cadena de conexión de Neon (con pooler). En local puede ser un Postgres en localhost.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Secreto para firmar la sesión del panel. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
# URL pública del sitio (se usa en los correos)
NEXT_PUBLIC_SITE_URL="https://gondola.vercel.app"

# Fotos de facturas (Vercel Blob) ------------------------------------------
# Se crea sola al conectar un Blob Store al proyecto en Vercel (Storage > Blob).
# Sin esta variable, en local las fotos se guardan en .uploads/.
BLOB_READ_WRITE_TOKEN=""

# Correo (opcional, Resend) ------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Mall San Pedro <sorteo@tudominio.com>"

# WhatsApp (opcional, Meta WhatsApp Cloud API) ------------------------------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Plantilla aprobada por Meta con 3 variables: {{1}} nombre, {{2}} tienda, {{3}} boletos
WHATSAPP_TEMPLATE_BOLETOS=""
# Plantilla opcional para anulaciones: {{1}} nombre, {{2}} factura, {{3}} motivo
WHATSAPP_TEMPLATE_ANULADA=""
WHATSAPP_TEMPLATE_LANG="es"
